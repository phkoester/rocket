<resource xmlns="http://www.wxwidgets.org/wxxrc" version="2.5.3.0">
  <object class="wxBitmap" name="logo">
    <bitmap default_size="192,192">logo.svg</bitmap>
  </object>
  <object class="wxBitmap" name="back">
    <bitmap default_size="24,24">back.svg</bitmap>
  </object>
  <object class="wxBitmap" name="forward">
    <bitmap default_size="24,24">forward.svg</bitmap>
  </object>
</resource>

