#!/usr/bin/env python3
#
# generate-hello
#

"""
Usage: generate-hello

Writes the generated source file to stdout.
"""

import argparse
import sys

def main():
  # Parse arguments
  parser = argparse.ArgumentParser()
  parser.parse_args()

  sys.stdout.write("const char* generated() { return \"Hello from `generate-hello`!\"; }\n")

  return 0

if __name__ == "__main__":
  sys.exit(main())

# EOF
