#!/usr/bin/env python3
#
# generate-version
#

"""
Usage: generate-version NAME VERSION

Writes the generated header to stdout.
"""

import argparse
import re
# Don't import `semver` here so the build will work without it
import sys

# Constants -------------------------------------------------------------------------------------------------

# Official SemVer 2.0.0 regex, see `https://semver.org`
SEMVER_RE = re.compile(
  r"^(?P<major>0|[1-9]\d*)\.(?P<minor>0|[1-9]\d*)\.(?P<patch>0|[1-9]\d*)"
  r"(?:-(?P<prerelease>(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)"
  r"(?:\.(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?"
  r"(?:\+(?P<buildmetadata>[0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-]+)*))?$"
)

# Functions -------------------------------------------------------------------------------------------------

def parse_version(version_string):
  match = SEMVER_RE.match(version_string)
  if not match:
    raise ValueError(f"`{version_string}` is not a valid SemVer string")
  return (
    int(match["major"]),
    int(match["minor"]),
    int(match["patch"]),
    match["prerelease"] or "",
    match["buildmetadata"] or ""
  )

def write_header(file, name, version_string):
  major, minor, patch, prerelease, build_metadata = parse_version(version_string)
  value = major * 1_000_000 + minor * 1_000 + patch

  file.write(
f"""/**
 * @file version.h
 *
 * This is a generated file. Do not edit.
 */

#pragma once

// NOLINTBEGIN

#define {name}_VERSION_NAME "{version_string}" ///< SemVer string.

#define {name}_VERSION_MAJOR {major} ///< Major.
#define {name}_VERSION_MINOR {minor} ///< Minor.
#define {name}_VERSION_PATCH {patch} ///< Patch.
#define {name}_VERSION_PRERELEASE "{prerelease}" ///< Prerelease, or empty.
#define {name}_VERSION_BUILD_METADATA "{build_metadata}" ///< Build metadata, or empty.

/// Comparable version value (1,000,000 * major + 1,000 * minor + patch)
#define {name}_VERSION {value}

// NOLINTEND

// EOF
""")

# `main`-----------------------------------------------------------------------------------------------------

def main():
  # Parse arguments
  parser = argparse.ArgumentParser()
  parser.add_argument(
    "name",
    type=str,
    help="name",
  )
  parser.add_argument(
    "version",
    type=str,
    help="version string",
  )
  args = parser.parse_args()

  write_header(sys.stdout, args.name, args.version)

  return 0

if __name__ == "__main__":
  sys.exit(main())

# EOF
