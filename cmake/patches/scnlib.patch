diff --git a/src/scn/impl.h b/src/scn/impl.h
index 7547b9f9..c317a214 100644
--- a/src/scn/impl.h
+++ b/src/scn/impl.h
@@ -1431,6 +1431,24 @@ struct file_buffer_interface {
                 file.unsafe_advance_n(pos_without_putback_buffer);
                 return position;
             }
+            if (pos_without_putback_buffer < 0) {
+                // The file has not been advanced past `current_view`, which is
+                // still in its buffer, so only the part of `putback_buffer`
+                // from `position` on is put back. Putting back `current_view`
+                // as well would make the file return it twice.
+                putback_guard guard{file};
+                for (auto i = pbb_size; i > position; --i) {
+                    if (!file.putback(
+                            putback_buffer[static_cast<std::size_t>(i - 1)])) {
+                        // Leave only what was not put back for
+                        // `set_prelude_after_sync`
+                        putback_buffer.resize(static_cast<std::size_t>(i));
+                        current_view = {};
+                        return i;
+                    }
+                }
+                return position;
+            }
         }
 
         putback_guard guard{file};
