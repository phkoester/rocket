+            if (pos_without_putback_buffer < 0) {
+                // The file has not been advanced past `current_view`, which is
+                // still in its buffer, so only the part of `putback_buffer`
+                // from `position` on is put back. Putting back `current_view`
+                // as well would make the file return it twice.
+                putback_guard guard{file};
+                for (auto i = pbb_size; i > position; --i) {
+                    if (!file.putback(
