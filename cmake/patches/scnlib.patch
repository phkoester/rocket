+/// Returns the number of days from 1970-01-01 to the given date in the
+/// proleptic Gregorian calendar, see
+/// https://howardhinnant.github.io/date_algorithms.html#days_from_civil
+constexpr std::int64_t days_from_civil(std::int64_t y, unsigned m, unsigned d)
+{
+    y -= m <= 2 ? 1 : 0;
+    const std::int64_t era = (y >= 0 ? y : y - 399) / 400;
+    const auto yoe = static_cast<unsigned>(y - era * 400);              // [0, 399]
+    const unsigned doy = (153 * (m > 2 ? m - 3 : m + 9) + 2) / 5 + d - 1;  // [0, 365]
+    const unsigned doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;         // [0, 146096]
+    return era * 146097 + static_cast<std::int64_t>(doe) - 719468;
+}
+
+/// Returns the number of days in month `m` of year `y`.
+constexpr unsigned days_in_month(std::int64_t y, unsigned m)
+{
+    if (m == 2) {
+        return (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)) ? 29 : 28;
+    }
+    return (m == 4 || m == 6 || m == 9 || m == 11) ? 30 : 31;
+}
+
+/// Converts `dt` to the time since the Unix epoch.
+///
+/// The fields are taken as UTC, as `system_clock` measures Unix time, and
+/// corrected by `tz_offset`, if set. This does not depend on the local time
+/// zone, unlike `std::mktime`, which takes the fields as local time. Unset
+/// fields default to 1970-01-01T00:00:00.
+///
+/// Returns `std::nullopt` if the day does not exist in the month, or if
+/// `tz_name`, `wday`, or `yday` is set, which cannot be applied.
 template <typename Duration>
 std::optional<Duration> time_since_unix_epoch(const datetime_components& dt)
 {
     static_assert(std::is_integral_v<typename Duration::rep>);
     static_assert(Duration::period::type::den <= std::nano::den);
 
-    if (dt.tz_offset || dt.tz_name || dt.wday || dt.yday) {
+    if (dt.tz_name || dt.wday || dt.yday) {
+        return std::nullopt;
+    }
+
+    const auto y = static_cast<std::int64_t>(dt.year.value_or(1970));
+    const auto m = static_cast<unsigned>(dt.mon.value_or(January));
+    const auto d = static_cast<unsigned>(dt.mday.value_or(1));
+    if (d < 1 || d > days_in_month(y, m)) {
         return std::nullopt;
     }
 
-    auto tm = dt.to_tm();
     // TODO: overflow checks
-#if SCN_MSVC && defined(SCN_MODULE)
-    // Workaround for https://github.com/llvm/llvm-project/issues/64812
-    // (can't use <ctime> std:: functions in modules)
-    auto time = std::chrono::seconds{::mktime(&tm)};
-#else
-    auto time = std::chrono::seconds{std::mktime(&tm)};
-#endif
+    auto time = std::chrono::seconds{
+        days_from_civil(y, m, d) * 86400 +
+        std::int64_t{dt.hour.value_or(0)} * 3600 +
+        std::int64_t{dt.min.value_or(0)} * 60 + std::int64_t{dt.sec.value_or(0)}};
+    if (dt.tz_offset) {
+        time -= *dt.tz_offset;
+    }
+
     if constexpr (Duration::period::type::den > std::intmax_t{1}) {
         // Duration more precise than seconds (seconds is std::ratio<1, 1>)
         if (dt.subsec) {
+            // Round, as the product is not exact: `0.529594325` times 1e9
+            // is slightly less than 529594325
             auto subsec_in_ns =
-                std::chrono::nanoseconds{static_cast<std::int64_t>(
-                    *dt.subsec * static_cast<double>(std::nano::den))};
+                std::chrono::nanoseconds{static_cast<std::int64_t>(std::llround(
+                    *dt.subsec * static_cast<double>(std::nano::den)))};
             return std::chrono::duration_cast<Duration>(time + subsec_in_ns);
         }
     }
